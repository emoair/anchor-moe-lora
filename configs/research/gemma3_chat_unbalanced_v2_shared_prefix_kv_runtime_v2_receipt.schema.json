        "planner_adapter_sha256": {"$ref": "#/$defs/sha256"},
        "output_adapter_sha256": {"$ref": "#/$defs/sha256"},
        "latent_packet": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "fixed_dimension",
            "serialization_sha256",
            "position_sha256",
            "commit_sha256",
            "hidden_chain_of_thought"
          ],
          "properties": {
            "enabled": {"const": false},
            "fixed_dimension": {"const": 0},
            "serialization_sha256": {"type": "null"},
            "position_sha256": {"type": "null"},
            "commit_sha256": {"type": "null"},
            "hidden_chain_of_thought": {"const": false}
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cold_recompute_executed",
        "shared_prefix_handoff_executed",
        "logits_digest_cold",
        "logits_digest_handoff",
        "logits_allclose",
        "logits_max_abs_error",
        "next_token_argmax_equal",
        "next_token_digest_cold",
        "next_token_digest_handoff",
        "prefill_count_cold",
        "prefill_count_handoff"
      ],
      "properties": {
        "cold_recompute_executed": {"type": "boolean"},
        "shared_prefix_handoff_executed": {"type": "boolean"},
        "logits_digest_cold": {"$ref": "#/$defs/shaOrNull"},
        "logits_digest_handoff": {"$ref": "#/$defs/shaOrNull"},
        "logits_allclose": {"type": "boolean"},
        "logits_max_abs_error": {
          "type": "number",
          "minimum": 0
        },
        "next_token_argmax_equal": {"type": "boolean"},
        "next_token_digest_cold": {"$ref": "#/$defs/shaOrNull"},
        "next_token_digest_handoff": {"$ref": "#/$defs/shaOrNull"},
        "prefill_count_cold": {"type": "integer", "minimum": 0},
        "prefill_count_handoff": {"type": "integer", "minimum": 0}
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_cache_unchanged",
        "planner_tail_private",
        "output_tail_private",
        "sibling_branch_unchanged",
        "private_tail_alias",
        "wrong_adapter_rejected",
        "wrong_position_rejected",
        "wrong_attention_mask_rejected",
        "cache_mutation_rejected",
        "pointer_observation_only"
      ],
      "properties": {
        "source_cache_unchanged": {"type": "boolean"},
        "planner_tail_private": {"type": "boolean"},
        "output_tail_private": {"type": "boolean"},
        "sibling_branch_unchanged": {"type": "boolean"},
        "private_tail_alias": {"type": "boolean"},
        "wrong_adapter_rejected": {"type": "boolean"},
        "wrong_position_rejected": {"type": "boolean"},
        "wrong_attention_mask_rejected": {"type": "boolean"},
        "cache_mutation_rejected": {"type": "boolean"},
        "pointer_observation_only": {"const": true}
      }
