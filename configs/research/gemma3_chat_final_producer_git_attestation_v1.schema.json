  "$defs": {
    "sha1": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "git_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status",
        "blob_sha1",
        "bytes",
        "sha256",
        "parent_blob_sha1"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "A",
            "M"
          ]
        },
        "blob_sha1": {
          "$ref": "#/$defs/sha1"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "parent_blob_sha1": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha1"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "runtime_copy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_path",
        "consumer_path",
