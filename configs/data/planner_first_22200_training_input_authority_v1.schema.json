{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anchor.planner-first-22200-training-input-authority.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "consumed", "training_authorized", "consumer_acceptance_identity", "teacher_final_semantic_root_sha256"],
  "properties": {
    "schema_version": {"const": "anchor.planner-first-22200-training-input-authority.v1"},
    "stage": {"const": "training_input_authority"},
    "consumed": {"const": false},
    "training_authorized": {"const": true},
    "consumer_acceptance_identity": {"$ref": "#/$defs/identity"},
    "teacher_final_semantic_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "path", "sha256"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
