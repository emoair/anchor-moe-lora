{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anchor://schemas/gemma3-chat-unbalanced-v2-teacher-alignment-receipt-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schema_version",
    "receipt_kind",
    "idempotency_key",
    "role",
    "language",
    "outcome",
    "reason_code",
    "output_record_sha256",
    "planner_lineage",
    "usage",
    "attempts",
    "binding",
    "committed_at",
    "content_retained",
    "planner_body_retained",
    "hmac_sha256"
  ],
  "properties": {
    "id": {"$ref": "#/$defs/sha256"},
    "schema_version": {
      "const": "anchor.gemma3-chat-five-expert-qonly-unbalanced-v2.teacher-alignment.receipt.v1"
    },
    "receipt_kind": {"const": "job"},
    "idempotency_key": {"$ref": "#/$defs/sha256"},
    "role": {
      "enum": ["humor", "serious", "angry", "tool", "review", "router", "identity"]
    },
    "language": {"enum": ["zh-CN", "en"]},
    "outcome": {"enum": ["succeeded", "rejected"]},
    "reason_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "output_record_sha256": {
      "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
    },
    "planner_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "cache_lineage",
        "execution",
        "handoff_claim",
        "ordered_prefix_commit_sha256",
        "overlay_identity_sha256",
        "new_adapter_prefix_recomputation_equivalent",
        "zero_copy",
        "shared_storage",
        "full_generation_sharing",
        "body_retained",
        "hidden_chain_of_thought"
      ],
      "properties": {
        "state": {"const": "not_executed_identity_placeholder"},
        "cache_lineage": {
          "const": ["P0", "P1", "selected_P2", "governed_P3"]
        },
        "execution": {"const": "boundary_switched_execution"},
        "handoff_claim": {
          "const": "exact ordered prefix-value / prefill-compute handoff"
        },
        "ordered_prefix_commit_sha256": {"$ref": "#/$defs/sha256"},
        "overlay_identity_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        },
        "new_adapter_prefix_recomputation_equivalent": {"const": false},
        "zero_copy": {"const": false},
        "shared_storage": {"const": false},
        "full_generation_sharing": {"const": false},
        "body_retained": {"const": false},
        "hidden_chain_of_thought": {"const": false}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "attempts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wire_attempts",
        "retry_count",
        "retry_reasons",
        "response_id"
      ],
      "properties": {
        "wire_attempts": {"type": "integer", "minimum": 1, "maximum": 3},
        "retry_count": {"type": "integer", "minimum": 0, "maximum": 2},
        "retry_reasons": {
          "type": "array",
          "maxItems": 2,
          "items": {"type": "string", "maxLength": 64}
        },
        "response_id": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_sha256",
        "source_identity_sha256",
        "manifest_sha256",
        "protected_test_identity_sha256",
        "planner_dag_contract_sha256",
        "derived_planner_overlay_schema_sha256",
        "model_binding_sha256",
        "implementation_sha256",
        "prompt_version",
        "profile_id",
        "profile_sha256"
      ],
      "properties": {
        "campaign_sha256": {"$ref": "#/$defs/sha256"},
        "source_identity_sha256": {"$ref": "#/$defs/sha256"},
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "protected_test_identity_sha256": {"$ref": "#/$defs/sha256"},
        "planner_dag_contract_sha256": {"$ref": "#/$defs/sha256"},
        "derived_planner_overlay_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "model_binding_sha256": {"$ref": "#/$defs/sha256"},
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "prompt_version": {"const": "unbalanced-v2-ark-final-only-v1"},
        "profile_id": {
          "enum": [
            "smoke_exact1",
            "bounded_small_c1",
            "bulk_c30",
            "bulk_c16"
          ]
        },
        "profile_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "committed_at": {"type": "string", "format": "date-time"},
    "content_retained": {"const": false},
    "planner_body_retained": {"const": false},
    "hmac_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
