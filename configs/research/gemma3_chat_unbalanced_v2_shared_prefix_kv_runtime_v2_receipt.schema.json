      "properties": {
        "layers": {"const": 26},
        "sliding_layers": {"const": 22},
        "full_layers": {"const": 4},
        "sliding_window": {"const": 512},
        "full_layer_indices": {
          "type": "array",
          "minItems": 0,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 25}
