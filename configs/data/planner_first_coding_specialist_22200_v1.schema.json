{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anchor.planner-first-coding-specialist-22200.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace",
    "replaces_existing",
    "strictly_serial",
    "max_concurrency",
    "stage_order",
    "problem_object_count",
    "legacy_coding_object_count",
    "legacy_candidate_pool_count",
    "planner_bootstrap_object_count",
    "legacy_source_is_training_data",
    "legacy_selection_rule",
    "planner_bootstrap_source_rule",
    "source_authority_requirements",
    "planner_primary_arm",
    "planner_diagnostic_arms_non_authorizing",
    "route_commit_rule",
    "expert_reentry_to_planner",
    "release_hash_dag",
    "provider_launch_authorized",
    "training_authorized",
    "formal_training_authorized",
    "body_reads",
    "raw_token_ids_read",
    "provider_requests",
    "model_loads",
    "gpu_runs"
