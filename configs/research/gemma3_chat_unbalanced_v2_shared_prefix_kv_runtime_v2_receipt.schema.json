        "layer_topology_sha256": {"$ref": "#/$defs/sha256"},
        "derived_from_authenticated_model_config": {"type": "boolean"},
        "layers_detail": {
          "type": "array",
          "minItems": 0,
          "maxItems": 26,
          "items": {"$ref": "#/$defs/layer"}
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_commit_sha256",
        "ordered_prefix_sha256",
        "token_order_sha256",
        "position_sha256",
        "attention_mask_sha256",
        "rope_sha256",
        "route_commit_sha256",
        "plan_commit_sha256",
        "prefix_tokens",
        "source_prefill_adapter_state",
        "planner_adapter_sha256",
        "output_adapter_sha256",
        "latent_packet"
      ],
