{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anchor.local/schemas/gemma3-chat-five-expert-qonly-unbalanced-v2-final-serialization-inventory.schema.json",
  "title": "Gemma 3 Chat unbalanced v2 FINAL body-free serialization inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "split",
    "language",
    "role",
    "messages_sha256",
    "target_sha256",
    "gemma_prompt_sha256",
    "gemma_full_example_sha256",
    "prompt_utf8_bytes",
    "target_utf8_bytes",
    "raw_token_ids_persisted",
    "tokenizer_called",
    "tokenization_claimed",
    "truncation_status",
    "claims"
  ],
  "properties": {
    "schema_version": {
      "const": "anchor.gemma3-chat-five-expert-qonly-unbalanced-v2-final-serialization-inventory.v1"
    },
    "record_id": {
      "type": "string",
      "pattern": "^gemma3-chat-unbalanced-v2-final:[0-9a-f]{64}:(humor|serious|angry_style|tool_call|review_audit)$"
    },
    "split": {
      "enum": [
        "train",
        "eval_proxy"
      ]
    },
    "language": {
      "enum": [
        "en",
        "zh-CN"
      ]
    },
    "role": {
      "enum": [
        "humor",
        "serious",
        "angry_style",
        "tool_call",
        "review_audit"
      ]
    },
    "messages_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "target_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "gemma_prompt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "gemma_full_example_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "prompt_utf8_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "target_utf8_bytes": {
      "type": "integer",
      "minimum": 1
    },
    "raw_token_ids_persisted": {
      "const": false
    },
    "tokenizer_called": {
      "const": false
    },
    "tokenization_claimed": {
      "const": false
    },
    "truncation_status": {
      "const": "not_evaluated_without_tokenizer"
    },
    "claims": {
      "$ref": "#/$defs/claims"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "diagnostic_only",
        "proxy_only",
        "training_authorized",
        "formal_training_authorized",
        "live_authorized",
        "release_authorized"
      ],
      "properties": {
        "diagnostic_only": {
          "const": true
        },
        "proxy_only": {
          "const": true
        },
        "training_authorized": {
          "const": false
        },
        "formal_training_authorized": {
          "const": false
        },
        "live_authorized": {
          "const": false
        },
        "release_authorized": {
          "const": false
        }
      }
    }
  }
}
