{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anchor.local/schemas/gemma3-chat-unbalanced-v2-shared-prefix-kv-runtime-v2-receipt.schema.json",
  "title": "Gemma 3 Chat unbalanced-v2 shared-prefix KV runtime v2 receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "status",
    "operation",
    "identity",
    "source",
    "topology",
    "boundary",
    "comparison",
    "isolation",
    "performance",
    "claims",
    "resource_counters",
    "failure_codes"
  ],
  "properties": {
