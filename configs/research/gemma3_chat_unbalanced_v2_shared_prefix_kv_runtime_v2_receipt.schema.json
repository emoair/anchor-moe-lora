        "passed_diagnostic_prefix_handoff",
        "failed_diagnostic_prefix_handoff"
      ]
    },
    "operation": {
      "enum": ["status", "validate", "dry-run", "execute"]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "config_sha256",
        "implementation_sha256",
        "consumer_receipt_sha256",
        "adapter_receipt_sha256",
        "model_identity_sha256",
        "tokenizer_identity_sha256",
        "training_serialization_inventory_sha256"
      ],
      "properties": {
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "consumer_receipt_sha256": {"$ref": "#/$defs/sha256"},
        "adapter_receipt_sha256": {"$ref": "#/$defs/shaOrPending"},
        "model_identity_sha256": {"$ref": "#/$defs/shaOrPending"},
        "tokenizer_identity_sha256": {"$ref": "#/$defs/shaOrPending"},
        "training_serialization_inventory_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authenticated",
        "producer_candidate_commit",
        "producer_release_commit",
        "producer_release_tree",
        "source_blob_path",
        "source_blob_sha256",
        "source_blob_bytes",
        "record_index",
        "record_sha256",
        "record_prompt_sha256",
        "example_serialization_sha256",
        "tokenizer_binding_sha256",
        "model_config_sha256",
        "hf_auto_tokenizer_used",
        "second_model_file_path_read",
        "runtime_special_token_overlay",
        "serialized_prefix_persisted"
      ],
      "properties": {
        "authenticated": {"type": "boolean"},
        "producer_candidate_commit": {"$ref": "#/$defs/commit"},
        "producer_release_commit": {"$ref": "#/$defs/commit"},
        "producer_release_tree": {"$ref": "#/$defs/tree"},
        "source_blob_path": {"type": "string", "minLength": 1},
        "source_blob_sha256": {"$ref": "#/$defs/sha256"},
        "source_blob_bytes": {"type": "integer", "minimum": 0},
        "record_index": {"type": "integer", "minimum": 0},
