{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "anchor.planner-first-22200-teacher-final.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "final", "semantic_root_sha256", "requested_object_count", "terminal_object_count", "planner_fused_lineage", "ordered_assets", "inventories", "training_authorized"],
  "properties": {
    "schema_version": {"const": "anchor.planner-first-22200-teacher-final.v1"},
    "stage": {"const": "teacher_final"},
    "final": {"const": true},
    "semantic_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "requested_object_count": {"const": 22200},
    "terminal_object_count": {"const": 22200},
    "planner_fused_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planner_adapter_sha256", "planner_freeze_receipt_sha256", "route_commit_root_sha256"],
      "properties": {
        "planner_adapter_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "planner_freeze_receipt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "route_commit_root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "ordered_assets": {"$ref": "#/$defs/assets"},
    "inventories": {"$ref": "#/$defs/inventories"},
    "training_authorized": {"const": false}
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "path", "records", "sha256"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1},
        "path": {"type": "string", "minLength": 1},
        "records": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chat_shards", "router_records"],
      "properties": {
        "chat_shards": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/asset"}},
        "router_records": {"$ref": "#/$defs/asset"}
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "root_sha256"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "root_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "inventories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted", "quarantine", "rejected"],
      "properties": {
        "accepted": {"$ref": "#/$defs/inventory"},
        "quarantine": {"$ref": "#/$defs/inventory"},
        "rejected": {"$ref": "#/$defs/inventory"}
      }
    }
  }
}
