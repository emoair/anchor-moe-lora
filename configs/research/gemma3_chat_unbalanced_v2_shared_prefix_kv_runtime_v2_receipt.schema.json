        "position_sha256": {"$ref": "#/$defs/sha256"},
        "attention_mask_sha256": {"$ref": "#/$defs/sha256"},
        "rope_sha256": {"$ref": "#/$defs/sha256"},
        "route_commit_sha256": {"$ref": "#/$defs/sha256"},
        "plan_commit_sha256": {"$ref": "#/$defs/sha256"},
        "prefix_tokens": {"type": "integer", "minimum": 1},
        "source_prefill_adapter_state": {
          "const": "adapter_off_frozen_base"
