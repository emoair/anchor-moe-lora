        "tokenizer_binding_sha256": {"$ref": "#/$defs/sha256"},
        "model_config_sha256": {"$ref": "#/$defs/sha256"},
        "hf_auto_tokenizer_used": {"const": false},
        "second_model_file_path_read": {"const": false},
        "runtime_special_token_overlay": {"const": true},
        "serialized_prefix_persisted": {"const": false}
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layers",
        "sliding_layers",
        "full_layers",
        "sliding_window",
        "full_layer_indices",
        "layer_topology_sha256",
        "derived_from_authenticated_model_config",
        "layers_detail"
